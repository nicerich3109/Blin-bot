# Discord
DISCORD_TOKEN=

# Local database (SQLite by default)
BLIN_DB_PATH=blin.sqlite3
BLIN_LEGACY_DATA_FILE=data.json

# Dashboard API
BLIN_API_HOST=127.0.0.1
BLIN_API_PORT=8080
BLIN_API_SECRET=generate-a-long-random-secret
BLIN_API_ALLOWED_ORIGINS=https://YOUR-GITHUB-USER.github.io
BLIN_DASHBOARD_URL=https://YOUR-GITHUB-USER.github.io/Blin-website/dashboard.html

# Dashboard Discord OAuth2 (server-side only)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-BLIN-API-DOMAIN.example.com/auth/callback

# Bot behavior
BLIN_TIMEZONE=Europe/Moscow
BLIN_JOIN_COOLDOWN=120
BLIN_LOG_FILE=bot.log
